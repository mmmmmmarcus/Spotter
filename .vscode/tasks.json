{
  "version": "2.0.0",
  "tasks": [
    {
      // Builds, atomically replaces /Applications/Spotter.app, and launches only that copy.
      "label": "Build & Run Spotter (debug)",
      "type": "shell",
      "command": "./Tools/run-local.sh Debug",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$swiftc"]
    },
    {
      // F5 installs the new build without launching it; the Swift debugger starts the installed binary.
      "label": "Install Spotter for Debugger",
      "type": "shell",
      "command": "./Tools/run-local.sh Debug --install-only",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": { "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer" }
      },
      "problemMatcher": ["$swiftc"]
    }
  ]
}
