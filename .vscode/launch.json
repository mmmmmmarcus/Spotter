{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 always debugs the canonical installed copy; the pre-launch task replaces it first.
      "type": "swift",
      "request": "launch",
      "name": "Debug /Applications/Spotter.app",
      "program": "/Applications/Spotter.app/Contents/MacOS/Spotter",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Install Spotter for Debugger"
    }
  ]
}
